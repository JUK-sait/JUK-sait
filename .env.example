# gdrivefs の設定例。使う方式に応じてコメントを外してください。

# ── 方式 1: OAuth2 リフレッシュトークン (推奨) ────────────────────────────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# ── 方式 2: サービスアカウント ──────────────────────────────────────────
# GOOGLE_SERVICE_ACCOUNT_FILE=/secure/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
# GOOGLE_IMPERSONATE_SUBJECT=user@example.com

# ── 方式 3: 短命なアクセストークン ──────────────────────────────────────
# GOOGLE_DRIVE_ACCESS_TOKEN=

# ── 共通設定 ───────────────────────────────────────────────────────────
# `/` に対応させる Drive フォルダ ID (未指定ならマイドライブ直下)
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# 共有ドライブを使う場合の ID
# GOOGLE_SHARED_DRIVE_ID=
# API ベース URL (プロキシ経由などで差し替える場合)
# GOOGLE_DRIVE_API_BASE=https://www.googleapis.com

# ── オフライン動作 (認証不要) ──────────────────────────────────────────
# GDRIVEFS_MEMORY=1
# GDRIVEFS_MEMORY_FILE=/tmp/gdrivefs-memory.json
